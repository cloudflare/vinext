{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-router-playground-kv",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "preview_urls": true,
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  // The KV namespace the response-store-demo KV deploys use; each deploy keys
  // its entries under its own VINEXT_KV_APP_PREFIX.
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "b38f84f642aa4bd4ba17a37bb516f0b5"
    }
  ]
}
