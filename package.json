{
  "name": "vinext-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "fixtures/*",
    "fixtures/ecosystem/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/vinext",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --deny-warnings",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@typescript/native-preview": "^7.0.0-dev.20260213.1",
    "image-size": "2.0.2",
    "oxlint": "^1.47.0",
    "playwright": "^1.52.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@unpic/react": "^1.0.2"
  }
}
