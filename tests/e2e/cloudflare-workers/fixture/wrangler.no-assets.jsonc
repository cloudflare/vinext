{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-dynamic-preload-no-assets",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.js",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js"] }],
}
