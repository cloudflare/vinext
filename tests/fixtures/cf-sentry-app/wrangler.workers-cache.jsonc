{
  "name": "cf-sentry-app-workers-cache",
  "compatibility_date": "2026-02-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "cache": { "enabled": false },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
}
