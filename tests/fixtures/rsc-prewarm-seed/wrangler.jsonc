{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "vinext-rsc-prewarm-seed",
  "main": "worker.ts",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../../examples/workers-cache/dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "b38f84f642aa4bd4ba17a37bb516f0b5",
    },
  ],
  "cache": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "preview_urls": true,
  "workers_dev": true,
}
