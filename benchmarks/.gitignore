# Copies of shared app in each project (generated by generate-app.mjs)
nextjs/app/
nextcompat/app/
nextcompat-rolldown/app/

# Build outputs
nextjs/.next/
nextcompat/dist/
nextcompat-rolldown/dist/

# Dependencies (each project has its own)
nextjs/node_modules/
nextcompat/node_modules/
nextcompat-rolldown/node_modules/

# Lock files
nextjs/package-lock.json
nextcompat/package-lock.json
nextcompat-rolldown/package-lock.json

# Next.js generated files
nextjs/next-env.d.ts
